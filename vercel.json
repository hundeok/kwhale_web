{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/officials/:path*", "destination": "/index.html" },
    { "source": "/rankings/:path*", "destination": "/index.html" },
    { "source": "/analysis/:path*", "destination": "/index.html" },
    { "source": "/map", "destination": "/index.html" },
    { "source": "/hotspot", "destination": "/index.html" },
    { "source": "/real-estate", "destination": "/index.html" },
    { "source": "/securities", "destination": "/index.html" },
    { "source": "/virtual-assets", "destination": "/index.html" },
    { "source": "/guide", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/participate", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
